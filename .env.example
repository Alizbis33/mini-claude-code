# 复制这个文件为 .env，然后填入你自己的 key
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入版本库。

# ── 必需 ──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-在这里填入你的key

# ── 可选（评测模式，不设置则行为和交互模式完全一样）──
# AGENT_AUTO=1          自动放行所有工具（评测时无人值守）
# AGENT_QUIET=1         不打印调试输出，stdout 只留最终回答
# AGENT_STATS_OUT=      把本轮统计写成 JSON 到这个路径
# AGENT_RETRY=3         API 重试次数上限（默认 3）
